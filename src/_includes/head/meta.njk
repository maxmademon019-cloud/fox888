<meta charset="utf-8">
<title>{{ seo.title }}</title>
<meta name="description" content="{{ seo.description }}">
<meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1">
<meta name="robots" content="index,follow,max-image-preview:large">
<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="canonical" href="{{ site.url }}">
<link rel="icon" type="image/png" sizes="{{ site.logo.width }}x{{ site.logo.height }}" href="{{ site.logo.src }}">
<link rel="apple-touch-icon" href="{{ site.logo.src }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ seo.title }}">
<meta property="og:description" content="{{ seo.description }}">
<meta property="og:url" content="{{ site.url }}">
<meta property="og:image" content="{{ site.heroImage.src }}">
<meta property="og:image:width" content="{{ site.heroImage.width }}">
<meta property="og:image:height" content="{{ site.heroImage.height }}">
<meta property="og:image:alt" content="{{ site.heroImage.alt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo.title }}">
<meta name="twitter:description" content="{{ seo.description }}">
<meta name="twitter:image" content="{{ site.heroImage.src }}">
<meta name="twitter:image:alt" content="{{ site.heroImage.alt }}">
